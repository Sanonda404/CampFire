# Supabase (CAMPFIRE_-prefixed names are what the runtime provisions; plain names also work)
CAMPFIRE_NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
CAMPFIRE_NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Alternative name Supabase now uses for the anon key:
# CAMPFIRE_NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only — used by API routes for writes the client must not do directly
CAMPFIRE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — OpenAI-compatible API for AI-generated sparks and recaps.
# Without these the app falls back to curated predefined challenges.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
